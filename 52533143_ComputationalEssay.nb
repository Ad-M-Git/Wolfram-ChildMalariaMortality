 CellTags->{"ExampleCodeText", "TemplateContent"},
 CellID->791589680,ExpressionUUID->"5d487ca5-450a-7043-84ff-eda03cf0ff3a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"for2000", " ", "=", " ", 
    RowBox[{"Select", "[", 
     RowBox[{"cleanData", ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], " ", "==", " ", "2000"}], " ", 
       "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GeoRegionValuePlot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Interpreter", "[", "\"\<Country\>\"", "]"}], "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "->", 
        RowBox[{"#", "[", 
         RowBox[{"[", "5", "]"}], "]"}]}], ")"}], "&"}], "/@", "for2000"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"ColorFunction", "->", "\"\<TemperatureMap\>\""}], ",", 
    RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"for2015", " ", "=", " ", 
    RowBox[{"Select", "[", 
     RowBox[{"cleanData", ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], " ", "==", " ", "2015"}], " ", 
       "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"GeoRegionValuePlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Interpreter", "[", "\"\<Country\>\"", "]"}], "[", 
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}], "->", 
       RowBox[{"#", "[", 
        RowBox[{"[", "5", "]"}], "]"}]}], ")"}], "&"}], "/@", "for2015"}], ",",
    "\[IndentingNewLine]", 
   RowBox[{"ColorFunction", "->", "\"\<BlueGreenYellow\>\""}], ",", 
   RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.986049611895874*^9, 3.986049611895874*^9}, {
  3.9860506553347416`*^9, 3.986050758698101*^9}},
 CellTags->{"ExampleInput", "TemplateContent"},
 CellLabel->"In[33]:=",
 CellID->602183444,ExpressionUUID->"96feba72-7ec5-c145-a9fc-c444f94c36b0"],

Cell["\<\
The global plot shows that the malaria child mortality is entirely \
concentrated in the sub-Saharan Africa. \
\>", "CodeText",
 CellChangeTimes->{{3.9861010095596066`*^9, 3.9861010845836487`*^9}},
 CellID->700114173,ExpressionUUID->"f18e6da3-d7a2-e049-9778-67d9b21fd774"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Time Series Analysis", "Section",
 CellChangeTimes->{{3.9860465047810345`*^9, 3.986046506796707*^9}, 
   3.9860468208254185`*^9},
 CellTags->{"SectionHeader", "TemplateContent"},
 CellID->119738624,ExpressionUUID->"085736f0-5b60-3f4c-bc24-bd2a6546b3b5"],

Cell["\<\
To demonstrate the global child malaria mortality, the total deaths across \
all countries for each year is aggregated and plotted as a time series.\
\>", "Text",
 CellChangeTimes->{{3.9860512883025513`*^9, 3.98605139035487*^9}},
 CellTags->{"ExampleTopicSentence", "TemplateContent"},
 CellID->32823794,ExpressionUUID->"7ee17c69-9822-be43-9394-156de4bdfc69"],

Cell["Grouping countries by year and total of deaths on that year.", \
"CodeText",
 CellChangeTimes->{{3.9860509639518433`*^9, 3.98605099989777*^9}},
 CellTags->{"ExampleCodeText", "TemplateContent"},
 CellID->303487927,ExpressionUUID->"353b95b2-e470-d443-a4fc-5a8d9b3e016e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"OverTimeData", " ", "=", 
   RowBox[{"GroupBy", "[", 
    RowBox[{"cleanData", ",", " ", 
     RowBox[{
      RowBox[{"#", "[", 
       RowBox[{"[", "2", "]"}], "]"}], " ", "&"}], ",", " ", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"#", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "5"}], "]"}], "]"}], "]"}], "&"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sortedOvertime", " ", "=", " ", 
    RowBox[{"KeySort", "[", "OverTimeData", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sortedYear", " ", "=", " ", 
   RowBox[{
    RowBox[{"Keys", "[", "sortedOvertime", "]"}], "//", " ", "Normal"}]}], 
  " ", ";", 
  RowBox[{"sortedTotalDeath", " ", "=", " ", 
   RowBox[{
    RowBox[{"Values", "[", "sortedOvertime", "]"}], " ", "//", " ", 
    "Normal"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.9860509456378975`*^9},
 CellTags->{"ExampleInput", "TemplateContent"},
 CellLabel->"In[37]:=",
 CellID->3397014,ExpressionUUID->"c5740a95-d56e-9341-bf44-95207926ee50"],

Cell["Plot: sum of deaths across all countries for each year", "CodeText",
 CellChangeTimes->{{3.9860509639518433`*^9, 3.98605099989777*^9}, {
  3.986051075725048*^9, 3.986051091562935*^9}},
 CellTags->{"ExampleCodeText", "TemplateContent"},
 CellID->534027518,ExpressionUUID->"48d22cce-81ff-d74e-9796-0a1e44d5a570"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", " ", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"sortedYear", ",", " ", "sortedTotalDeath"}], "}"}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "->", " ", 
    RowBox[{"Style", "[", 
     RowBox[{"\"\<Global Child Under 5 Malaria Mortality  across 2000 to 2015\
\>\"", ",", " ", "Bold", ",", " ", "12"}], "]"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Thick", ",", " ", "Blue"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"GridLines", "->", "None"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Filling", "->", "Axis"}], ",", "\[IndentingNewLine]", 
   RowBox[{"FillingStyle", "->", 
    RowBox[{"Lighter", "[", 
     RowBox[{"Blue", ",", " ", "0.4"}], "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Year\>\"", ",", " ", "\"\<Total Deaths\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.985882509765379*^9, 3.985882515498913*^9}, {
   3.9858825706861115`*^9, 3.985882575247183*^9}, {3.9858826107426567`*^9, 
   3.9858829164645977`*^9}, {3.9858829664331493`*^9, 
   3.9858829883232822`*^9}, {3.98588303062286*^9, 3.985883102465784*^9}, {
   3.9858833587481766`*^9, 3.9858833708747635`*^9}, {3.9858834184388905`*^9, 
   3.985883436131422*^9}, {3.9859502008057384`*^9, 3.985950206383545*^9}, {
   3.9859503961023846`*^9, 3.985950411827568*^9}, {3.9859504419776535`*^9, 
   3.9859504445941734`*^9}, {3.985950745821121*^9, 3.985950746852154*^9}, {
   3.9859508433826237`*^9, 3.985950856126463*^9}, 3.9860510351662445`*^9, {
   3.9861030444324646`*^9, 3.986103044952389*^9}},
 CellLabel->"In[44]:=",
 CellID->264723741,ExpressionUUID->"7b7f2064-15cb-fe47-b3f2-6bd4e6bd7e8f"],

Cell["\<\
The time series illustrates global child malaria peaked through 2000s and \
have declined substantially since. \
\>", "CodeText",
 CellChangeTimes->{{3.986051406689476*^9, 3.986051467213909*^9}},
 CellTags->"TemplateContent",
 CellID->648272937,ExpressionUUID->"fbfe5e48-f9e2-e847-b5ee-f10584cdada9"],

Cell["\<\
To demonstrate the rate of change of deaths more precisely, the change in \
percentage over years is calculated and plotted.\
\>", "Text",
 CellChangeTimes->{{3.9860512883025513`*^9, 3.98605139035487*^9}, {
  3.9860516027233276`*^9, 3.9860516860792522`*^9}},
 CellTags->{"ExampleTopicSentence", "TemplateContent"},
 CellID->60766015,ExpressionUUID->"104cc512-8642-284d-8c43-009d0fa2105e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Change", " ", "in", " ", "death", " ", "percentage", " ", "across", " ", 
    "years"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"yearChange", " ", "=", " ", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"sortedYear", "[", 
        RowBox[{"[", "x", "]"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"100", " ", "*", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"sortedTotalDeath", "[", 
            RowBox[{"[", "x", "]"}], "]"}], "-", " ", 
           RowBox[{"sortedTotalDeath", "[", 
            RowBox[{"[", 
             RowBox[{"x", "-", "1"}], "]"}], "]"}]}], ")"}], "/", " ", 
         RowBox[{"sortedTotalDeath", "[", 
          RowBox[{"[", 
           RowBox[{"x", "-", "1"}], "]"}], "]"}]}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "1", ",", 
       RowBox[{"Length", "[", "sortedYear", "]"}]}], "}"}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9860515076784954`*^9, 3.9860515389296875`*^9}, 
   3.9860515828004*^9},
 CellLabel->"In[42]:=",
 CellID->879433598,ExpressionUUID->"096ff06c-ea23-6d45-8be5-fd21d84cf42c"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"yearChange", ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"Style", "[", 
     RowBox[{"\"\<Change in % across years\>\"", ",", " ", "Bold", ",", " ", 
      "12"}], "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Thick", ",", " ", "Yellow"}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"GridLines", "->", "None"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Filling", "->", "Axis"}], ",", "\[IndentingNewLine]", 
   RowBox[{"FillingStyle", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Lighter", "[", 
       RowBox[{"Red", ",", " ", "0.4"}], "]"}], ",", " ", 
      RowBox[{"Lighter", "[", 
       RowBox[{"Orange", ",", " ", "0.4"}], "]"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Year\>\"", ",", " ", "\"\<Percentage change\>\""}], "}"}]}],
    ",", "\[IndentingNewLine]", 
   RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.9860515405717373`*^9, 3.986051548643162*^9}},
 CellLabel->"In[43]:=",
 CellID->13873592,ExpressionUUID->"4910472e-27f3-094a-9a8a-4400fd9ce9ee"],

Cell["\<\
The change in percentage remained negative throughout the period of 15 years. \
The most significant drop occurred around 2011. However, there is an upward \
slope toward the most recent years showing the rate of decline in global \
deaths is slowing down.\
\>", "CodeText",
 CellChangeTimes->{{3.986051406689476*^9, 3.986051467213909*^9}, {
  3.986051810494564*^9, 3.9860518111438866`*^9}, {3.9860518667309265`*^9, 
  3.986051996143154*^9}, {3.9860520650428696`*^9, 3.9860520911994686`*^9}},
 CellTags->"TemplateContent",
 CellID->385351403,ExpressionUUID->"39c23645-b6c1-9a44-a17a-4a8659a8abf9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Linear Model", "Section",
 CellChangeTimes->{{3.986046522026905*^9, 3.986046539127205*^9}, {
  3.9860468270785637`*^9, 3.9860468298965015`*^9}},
 CellTags->{"SectionHeader", "TemplateContent"},
 CellID->149172336,ExpressionUUID->"42456f02-7c4d-2148-a5f2-2e52a67c0c50"],

Cell["\<\
Linear Model is used to fit a straight line to the time series to capture the \
long running trend of global child malaria deaths using year as the predictor.\
\>", "Text",
 CellChangeTimes->{{3.986052254737919*^9, 3.9860523187240715`*^9}},
 CellTags->{"ExampleTopicSentence", "TemplateContent"},
 CellID->909384247,ExpressionUUID->"2b148ee9-a2e8-0342-8769-774cc4c53cfa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cleanYear", " ", "=", 
    RowBox[{"N", "[", 
     RowBox[{"Flatten", "[", "sortedYear", "]"}], "]"}]}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{"to", " ", "plain", " ", "numeric", " ", "lists"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cleanTotal", " ", "=", " ", 
    RowBox[{"N", "[", 
     RowBox[{"Flatten", "[", "sortedTotalDeath", "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"cleanTotal", "[", 
    RowBox[{"[", "1", "]"}], "]"}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9860521250594635`*^9, 3.9860522064050407`*^9}},
 CellTags->{"ExampleInput", "TemplateContent"},
 CellLabel->"In[55]:=",
 CellID->440691481,ExpressionUUID->"f44181a9-b5e2-1449-a2e4-e5bdeb045e9a"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"yearOffset", " ", "=", " ", 
     RowBox[{"Min", "[", "cleanYear", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"centerYear", " ", "=", " ", 
     RowBox[{"cleanYear", " ", "-", " ", "yearOffset"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "year", " ", "centered", " ", "at", " ", "the", " ", "first", " ", 
      "observation"}], ";", " ", 
     RowBox[{"year", " ", "since", " ", "2000"}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linearModel", " ", "=", " ", 
     RowBox[{"LinearModelFit", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"centerYear", ",", " ", "cleanTotal"}], " ", "}"}], "]"}], ",",
        " ", "x", ",", "x"}], "]"}]}], ";"}], " "}]}]], "Input",
 CellChangeTimes->{{3.986052356538576*^9, 3.986052434232527*^9}, {
  3.9860525124954777`*^9, 3.9860525160580463`*^9}, {3.986053394795004*^9, 
  3.98605339585071*^9}, {3.986054359370573*^9, 3.9860543705006046`*^9}},
 CellLabel->"In[57]:=",
 CellID->276274294,ExpressionUUID->"f1525432-61aa-2c45-b5e8-26ff781738e1"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"cleanYear", ",", "cleanTotal"}], "}"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", " ", "Red"}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", "\"\<Observed\>\"", "}"}]}]}], "\[IndentingNewLine]", 
      "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"linearModel", "[", 
        RowBox[{"x", "-", "yearOffset"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"Min", "[", "cleanYear", "]"}], ",", 
         RowBox[{"Max", "[", "cleanTotal", "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Dashed", ",", " ", "Blue"}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"AxesLabel", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Year\>\"", ",", " ", "\"\<Deaths\>\""}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", "\"\<Linear Regression\>\"", "}"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], " ", "\[IndentingNewLine]", "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9860543733003025`*^9, 3.9860543914230537`*^9}, {
  3.9861011833174744`*^9, 3.9861012255004997`*^9}},
 CellLabel->"In[213]:=",
 CellID->256457679,ExpressionUUID->"25dd6e08-30e6-6645-9e99-53be86bb1e6d"],

Cell["\<\
The line of best fit shown by blue dashed line calculated by plotting the \
linearModel. 

The actual total child mortality is represented by the red dots across the \
years.

The alignment between the observed mortality data(red dots) and predicted \
regression line(blue dashed) depicts the decline in malaria deaths.
\
\>", "CodeText",
 CellChangeTimes->{{3.9860525722238846`*^9, 3.986052724710226*^9}, {
  3.9860527962249565`*^9, 3.986052840186699*^9}, {3.9860528789553986`*^9, 
  3.9860529666059895`*^9}, {3.986053026587944*^9, 3.986053118995426*^9}, {
  3.986053245953953*^9, 3.986053322688143*^9}, {3.9860545219556026`*^9, 
  3.986054661048048*^9}, {3.9860547197228374`*^9, 3.986054780007908*^9}},
 CellTags->"TemplateContent",
 CellID->609690119,ExpressionUUID->"fd70cdd6-866c-c44f-99ac-c9bab1296064"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Print", "[", "\"\<Linear Model: Parameter Table\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{"linearModel", "[", "\"\<ParameterTable\>\"", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9860543518168583`*^9, 3.9860543610753098`*^9}},
 CellLabel->"In[69]:=",
 CellID->252976964,ExpressionUUID->"24edf9e4-4672-de4b-8abf-86bedd202f91"],

Cell["\<\
The parameter table of the linearModel suggest the estimated number of global \
child malaria deaths at year 0(i.e. Intercept) is 695,232. 

The negative slope of -29,006.3 suggests decline in deaths by an average of \
29,006.

p-value(0.0001) is lower than 0.05. Therefore the result is statistically \
significant. There is strong evidence for reduction in child malaria deaths \
is not due to chance.\
\>", "CodeText",
 CellChangeTimes->{{3.9860525722238846`*^9, 3.986052724710226*^9}, {
   3.9860527962249565`*^9, 3.986052840186699*^9}, {3.9860528789553986`*^9, 
   3.9860529666059895`*^9}, {3.986053026587944*^9, 3.986053118995426*^9}, 
   3.986053318117054*^9},
 CellTags->"TemplateContent",
 CellID->25445912,ExpressionUUID->"5997717c-337e-6746-bbf7-af98ecf0903e"],

Cell[BoxData[{
 RowBox[{"Print", "[", "\"\<Linear Model: ANOVA Table\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"linearModel", "[", "\"\<ANOVATable\>\"", "]"}]}], "Input",
 CellChangeTimes->{
  3.986052994925558*^9, {3.986053150790941*^9, 3.9860531556340294`*^9}},
 CellLabel->"In[62]:=",
 CellID->402479701,ExpressionUUID->"055bf059-fbba-d144-8903-5e9f350ba5e1"],

Cell["\<\
The Analysis of Variance(ANOVA) table shows a highly significant model with \
f-statistics = 1087.62, p<0.0001.
\
\>", "CodeText",
 CellChangeTimes->{{3.9860525722238846`*^9, 3.986052724710226*^9}, {
  3.9860527962249565`*^9, 3.986052840186699*^9}, {3.9860528789553986`*^9, 
  3.9860529666059895`*^9}, {3.986053026587944*^9, 3.986053118995426*^9}, {
  3.986053245953953*^9, 3.986053322688143*^9}},
 CellTags->"TemplateContent",
 CellID->253446402,ExpressionUUID->"434d4f95-cfd2-6947-8948-937a348452a7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<R-squared:\>\"", ",", " ", 
    RowBox[{"linearModel", "[", "\"\<RSquared\>\"", "]"}]}], "]"}], " "}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Adjusted R-squared:\>\"", ",", " ", 
   RowBox[{"linearModel", "[", "\"\<AdjustedRSquared\>\"", "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Intercept | estimated deaths in\>\"", ",", " ", "yearOffset", 
    ",", "\"\<:\>\"", ",", " ", 
    RowBox[{"Round", "[", 
     RowBox[{
      RowBox[{"linearModel", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Slope | Change in deaths per year:\>\"", ",", " ", 
    RowBox[{"Round", "[", 
     RowBox[{
      RowBox[{"linearModel", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.9860533669385815`*^9, 3.9860534118583145`*^9}},
 CellLabel->"In[64]:=",
 CellID->142157165,ExpressionUUID->"5e107e96-5928-5942-adf9-46696604d11f"],

Cell["\<\
R-squared of 0.987 suggest 98.7% total variation in global child malaria \
death can be explained by the predictor variable year.

Adjusted R-squared accounts for one predictor i.e. year.
\
\>", "CodeText",
 CellChangeTimes->{{3.9860525722238846`*^9, 3.986052724710226*^9}, {
  3.9860527962249565`*^9, 3.986052840186699*^9}, {3.9860528789553986`*^9, 
  3.9860529666059895`*^9}, {3.986053026587944*^9, 3.986053118995426*^9}, {
  3.986053245953953*^9, 3.986053322688143*^9}, {3.986053557338436*^9, 
  3.98605364839118*^9}, {3.9860537181925716`*^9, 3.9860537473646774`*^9}, {
  3.986053779233946*^9, 3.9860537809353695`*^9}},
 CellTags->"TemplateContent",
 CellID->108843449,ExpressionUUID->"5fdd5366-c6bc-744b-9549-94616859251c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Generalised Linear Model | Poisson Regression", "Section",
 CellChangeTimes->{3.9860468323960133`*^9},
 CellTags->{"SectionHeader", "TemplateContent"},
 CellID->15808217,ExpressionUUID->"775009ff-e742-bd48-9faf-c68ef4ab26d9"],

Cell["\<\
Poisson Regression Model implemented on death count variable as it models the \
log of the expected count as a linear function of the predictor, ensuring \
fitted values are positive and assumes that the variances scales with the \
mean. The death counts cannot be negative and are proportional to the \
population size.

Poisson GLM fitted to the time series between log-transformed death count and \
year to figure out the highest burden country in the dataset.\
\>", "Text",
 CellChangeTimes->{{3.9860538489984913`*^9, 3.986053859862604*^9}, {
  3.9860538904544106`*^9, 3.9860539016880493`*^9}, {3.986053971758898*^9, 
  3.9860540738357983`*^9}, {3.986054104771696*^9, 3.9860542180611115`*^9}, {
  3.986100019792471*^9, 3.9861000584598255`*^9}},
 CellTags->{"ExampleTopicSentence", "TemplateContent"},
 CellID->10397259,ExpressionUUID->"b30782ef-e062-134d-a41c-e2153f1c26fb"],

