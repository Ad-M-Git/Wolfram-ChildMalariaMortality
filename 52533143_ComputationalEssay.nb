Cell["Data structure", "CodeText",
 CellChangeTimes->{{3.9860509639518433`*^9, 3.98605099989777*^9}, {
  3.986051146633198*^9, 3.986051157177019*^9}},
 CellTags->{"ExampleCodeText", "TemplateContent"},
 CellID->380020841,ExpressionUUID->"78fa5e99-c574-4a48-8a0b-702a3c9ea068"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Dataset", "[", "ChildData", "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Since", " ", "all", " ", "the", " ", "data", " ", "is", " ", "inside", " ",
      "a", " ", "nested", " ", "TimeSeries"}], " ", ",", " ", 
    RowBox[{
    "the", " ", "data", " ", "first", " ", "needs", " ", "to", " ", "be", " ", 
     RowBox[{"restructed", "."}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Keys", "[", 
   RowBox[{"ChildData", "[", 
    RowBox[{"[", "1", "]"}], "]"}], "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"NormalData", " ", "=", " ", 
  RowBox[{"Normal", "[", "ChildData", "]"}], "  "}]}], "Input",
 CellChangeTimes->{
  3.986047783548897*^9, {3.98604813818013*^9, 3.9860481411729374`*^9}, {
   3.9860482017044945`*^9, 3.9860482239321766`*^9}, {3.9860482931027584`*^9, 
   3.9860482933094025`*^9}},
 CellTags->{"ExampleInput", "TemplateContent"},
 CellLabel->"In[5]:=",
 CellID->20666422,ExpressionUUID->"950b29c2-443c-bd4e-9c97-37d3fd2c143e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NormalData", "[", 
   RowBox[{"[", "1", "]"}], "]"}], " ", "//", " ", "FullForm", "  ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "FullForm", " ", "shows", " ", "that", " ", "every", " ", "row", " ", 
     "has", " ", "countries"}], ",", " ", 
    RowBox[{"and", " ", "ages", " ", "enclosed", " ", "in", " ", "a", " ", 
     RowBox[{"Quantity", "[", 
      RowBox[{"n", ",", " ", "\"\<People\>\""}], "]"}], " ", "with", " ", 
     "dates", " ", "from", " ", "2000", " ", "to", " ", "2015"}]}], 
   "*)"}]}]], "Input",
 CellChangeTimes->{
  3.986047783548897*^9, 3.9860482532887783`*^9, {3.986048294676302*^9, 
