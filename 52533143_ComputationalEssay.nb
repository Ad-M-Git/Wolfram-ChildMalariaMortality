 CellTags->{"SectionHeader", "TemplateContent"},
 CellID->104729775,ExpressionUUID->"95aa2fbc-dcca-ec43-9701-6504f37e2aa0"],

Cell["\<\
The first step to the time series analysis on evaluation of mortality rates \
among children due to malaria is data extraction, inspecting its structure \
and cleaning for the further processing.

Variables included in the dataset are:\
\>", "Text",
 CellChangeTimes->{{3.986046350640238*^9, 3.9860463559596386`*^9}, 
   3.9860463977413883`*^9, {3.986047633696417*^9, 3.9860477300660267`*^9}, {
   3.9860512294164963`*^9, 3.986051237976303*^9}},
 CellTags->{"ExampleTopicSentence", "TemplateContent"},
 CellID->579470569,ExpressionUUID->"5e1f7fe7-17bc-a849-a7eb-5afa7fd665f4"],

Cell["Country", "Item",
 CellChangeTimes->{{3.986047976891901*^9, 3.9860479790639*^9}, {
  3.986048082224394*^9, 3.986048082224394*^9}},
 CellTags->"TemplateContent",
 CellID->50855064,ExpressionUUID->"f255bbd4-ea99-3b44-b9c6-a892a612e6ed"],

