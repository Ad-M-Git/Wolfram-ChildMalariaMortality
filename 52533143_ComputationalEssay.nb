 CellChangeTimes->{{3.9860998067546616`*^9, 3.9860998078021736`*^9}},
 CellLabel->"In[214]:=",
 CellID->671951423,ExpressionUUID->"feee99b7-a802-f145-a9f4-f0f0877e0ca7"],

Cell["\<\

The plot visualises Poisson GLM for Nigeria. The main focus of Poisson curve \
is to highlight the proportional decline.

The actual observed child mortality shown by red dots depicts relative \
stagnation during the initial years with vast shift in the trajectory for \
subsequent years.
The expected deaths represented by blue line displays characteristic \
exponential decay curve.\
\>", "CodeText",
 CellChangeTimes->{
  3.9860998793938103`*^9, {3.9860999137689495`*^9, 3.9860999345253105`*^9}, {
   3.986100085942627*^9, 3.9861001079491463`*^9}, {3.986100166394129*^9, 
   3.9861002071633606`*^9}, {3.9861003281081276`*^9, 
   3.9861003546801395`*^9}, {3.986100404563751*^9, 3.986100425152788*^9}, {
   3.9861004627092953`*^9, 3.9861004944016914`*^9}, {3.986100540117199*^9, 
   3.9861005493188744`*^9}},
 CellID->74484114,ExpressionUUID->"54567178-0c22-824e-9592-7c36d5eb7e66"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Linear Model vs GLM", "Section",
 CellChangeTimes->{{3.986046865457573*^9, 3.9860468739828777`*^9}},
 CellTags->{"SectionHeader", "TemplateContent"},
 CellID->834923204,ExpressionUUID->"c1535bea-5aed-114f-9e79-ef89777d5daa"],

Cell["\<\
Using the Akaike Information Criterion(AIC) that balances goodness of fit \
against model complexity, linear model is compared with Poisson generalised \
linear model.\
\>", "Text",
 CellChangeTimes->{{3.98610067525992*^9, 3.9861006759070263`*^9}, {
  3.986100709545555*^9, 3.9861007709959984`*^9}},
 CellTags->{"ExampleTopicSentence", "TemplateContent"},
 CellID->90396325,ExpressionUUID->"1d7f5de3-a1fd-064a-ae73-ed6d25798fea"],

Cell["Model Comparison ", "CodeText",
 CellChangeTimes->{{3.986100622259901*^9, 3.986100628668104*^9}, {
  3.986100667675045*^9, 3.9861006696922665`*^9}},
 CellTags->{"ExampleCodeText", "TemplateContent"},
 CellID->292005171,ExpressionUUID->"7a3463e9-950b-9142-a6b2-19df9e28a7f6"],

Cell[BoxData[
 RowBox[{"lmCountry", " ", "=", " ", 
  RowBox[{"LinearModelFit", "[", " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Linear", " ", "model"}], ",", " ", 
     RowBox[{"comparison", " ", "on", " ", "same", " ", "country"}]}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"centerTopYear", ",", " ", "topDeath"}], "}"}], "]"}], ",", 
    "\[IndentingNewLine]", "x", ",", "x"}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{
  3.98610057939336*^9, {3.98610066366012*^9, 3.9861006643742313`*^9}},
 CellTags->{"ExampleInput", "TemplateContent"},
 CellLabel->"In[207]:=",
 CellID->838147287,ExpressionUUID->"402ea1c1-232b-9e46-9a18-778f4d628689"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Model Comparisons: \>\"", ",", " ", 
      RowBox[{"topCountry", "[", 
       RowBox[{"[", 
        RowBox[{"5", ",", "1"}], "]"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Linear Model AIC: \>\"", ",", " ", 
      RowBox[{"lmCountry", "[", "\"\<AIC\>\"", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Poisson GLM AIC: \>\"", ",", " ", 
      RowBox[{"glm", "[", "\"\<AIC\>\"", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Difference: \>\"", ",", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"lmCountry", "[", "\"\<AIC\>\"", "]"}], "-", 
       RowBox[{"glm", "[", "\"\<AIC\>\"", "]"}]}], ")"}], 
     ",", "\"\<, Lower AIC is better\>\""}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.986100590058195*^9, 3.986100590876564*^9}},
 CellLabel->"In[208]:=",
 CellID->894589510,ExpressionUUID->"ee21602e-e161-4a44-8c7c-081a75f4c263"],

Cell["\<\
 Poisson model is more theoretically better for positive count data like the \
child malaria death count variable,  however the linear model has a lower AIC \
and thus provided a better mathematical fit for this dataset.\
\>", "CodeText",
 CellChangeTimes->{{3.9861008261594067`*^9, 3.9861009510283184`*^9}, 
   3.98610128361899*^9},
 CellTags->"TemplateContent",
 CellID->149066813,ExpressionUUID->"db515066-c37c-fe4a-a56c-d82e36a052e0"],

