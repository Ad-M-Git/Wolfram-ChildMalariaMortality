       RowBox[{"{", "\"\<Observed\>\"", "}"}]}]}], "\[IndentingNewLine]", 
     "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Plot", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"lmCountry", "[", 
         RowBox[{"x", "-", 
          RowBox[{"Min", "[", "topYear", "]"}]}], "]"}], ",", 
        RowBox[{"glm", "[", 
         RowBox[{"x", "-", 
          RowBox[{"Min", "[", "topYear", "]"}]}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"Min", "[", "topYear", "]"}], ",", " ", 
        RowBox[{"Max", "[", "topYear", "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Thick", ",", " ", "Black"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Thick", ",", " ", "Blue"}], "}"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Linear Model\>\"", ",", "\"\<Poisson GLM\>\""}], 
        "}"}]}]}], "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotLabel", " ", "->", " ", "\[IndentingNewLine]", 
     RowBox[{"Style", "[", "\[IndentingNewLine]", 
      RowBox[{"\"\<Linear model vs Poisson GLM in \>\"", ",", "country1", " ",
        ",", " ", "Bold"}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Year\>\"", ",", "\"\<Deaths\>\""}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9861012480072308`*^9, 3.986101281402458*^9}, {
  3.9861014180260296`*^9, 3.986101450581806*^9}, {3.986101483526375*^9, 
  3.9861015456490498`*^9}, {3.9861016181626587`*^9, 3.986101686012085*^9}},
 CellLabel->"In[220]:=",
 CellID->63073616,ExpressionUUID->"253c5538-d54c-784a-adfd-80fba39ca468"],

Cell["\<\
Comparative plot visualises two statistical model for Nigeria. 

The linear model(black line) suggests annual reduction in absolute deaths \
while the Poisson GLM model(blue line) models proportional decline.\
\[LineSeparator]\[LineSeparator]While the Poisson model prevents predicting \
negative deaths, upon comparison, the linear model provides a strong evidence \
by its lower AIC that it is a greater fit for this specific data.
\
\>", "CodeText",
 CellChangeTimes->{{3.9861017515417805`*^9, 3.986101783909342*^9}, {
  3.986101840397276*^9, 3.9861019973900757`*^9}},
 CellID->236318737,ExpressionUUID->"70cc5b74-22f9-4549-ba6d-df453920401f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Conclusion", "Section",
 CellChangeTimes->{{3.986046899096239*^9, 3.9860469008682404`*^9}},
 CellTags->{"SectionHeader", "TemplateContent"},
 CellID->955669164,ExpressionUUID->"81e3ccfa-953c-8147-9f37-772d42bb3915"],

Cell["\<\
This computational essay provided justification for the previously mentioned \
research questions; \
\>", "Text",
 CellChangeTimes->{{3.986102064893629*^9, 3.9861021146159*^9}},
 CellTags->{"ExampleTopicSentence", "TemplateContent"},
 CellID->359501191,ExpressionUUID->"f9957161-799b-c346-8292-8cbac422f025"],

Cell["\<\
 The global child mortality due to malaria has substantially reduced over the \
period of 2000 through 2015.\
\>", "Item",
 CellChangeTimes->{{3.9861021162578716`*^9, 3.9861021852149277`*^9}},
 CellID->569082885,ExpressionUUID->"da053c4b-187b-5c49-82b2-fdb52b314ceb"],

Cell["\<\
With mortality rates relatively higher among these African region(top ten): \
Nigeria, Democratic Republic of the Congo, Burkina Faso, Ivory Coast, Uganda, \
Mali, Mozambique, Angola, Cameroon, Niger.  \
\>", "Item",
 CellChangeTimes->{{3.9861021162578716`*^9, 3.986102275141178*^9}},
 CellID->589430129,ExpressionUUID->"25952168-746e-2a42-b0c6-947d271c8bd8"],

Cell["\<\
Time Series analysis revealed that global child deaths accelerated through \
1990s and peaked in the 2000s with considerable decline since then.

Geospatial visualisation demonstrated the geographical inequality with \
sub-Saharan Africa with a disproportionate share of the global burden.

Linear model declared year as a significant predictor of global deaths and \
the slope disclosed an annual average reduction. Poisson GLM confirmed the \
deaths in high burdened country decreased by a percentage every year. \
\>", "Text",
 CellChangeTimes->{{3.986102283842993*^9, 3.986102412857046*^9}, {
  3.9861024640268536`*^9, 3.986102536669983*^9}, {3.986102566694006*^9, 
  3.9861027298691673`*^9}},
 CellID->79432307,ExpressionUUID->"9d99f4d0-db73-7644-9931-205790e238e4"]
}, Open  ]]
}, Open  ]]
