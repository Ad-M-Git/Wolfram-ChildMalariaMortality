 CellTags->{"ExampleInput", "TemplateContent"},
 CellLabel->"In[8]:=",
 CellID->48530882,ExpressionUUID->"bb2041b6-3416-b94a-9577-0c9884a5f6b0"],

Cell["Data restructure", "CodeText",
 CellChangeTimes->{{3.9860509639518433`*^9, 3.98605099989777*^9}, {
  3.986051146633198*^9, 3.986051157177019*^9}, {3.9860511896784344`*^9, 
  3.9860512013803425`*^9}},
 CellTags->{"ExampleCodeText", "TemplateContent"},
 CellID->296318760,ExpressionUUID->"0a6c8925-f48c-ea4a-b101-37401e4d02d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cleanData", " ", "=", " ", 
   RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "country", ",", " ", "year", ",", " ", "neonatal", ",", " ", 
           "postnatal", ",", " ", "under5"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"country", " ", "=", " ", 
           RowBox[{"CommonName", "[", 
            RowBox[{"NormalData", "[", 
             RowBox[{"[", 
              RowBox[{"x", ",", " ", "\"\<Country\>\""}], "]"}], "]"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"year", " ", "=", " ", 
           RowBox[{"DateValue", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"NormalData", "[", 
               RowBox[{"[", 
                RowBox[{"x", ",", " ", "\"\<Aged0To4Years\>\""}], "]"}], 
               "]"}], "[", "\"\<Dates\>\"", "]"}], ",", "\"\<Year\>\""}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"neonatal", " ", "=", " ", 
           RowBox[{"QuantityMagnitude", "/@", " ", 
            RowBox[{
             RowBox[{"NormalData", "[", 
              RowBox[{"[", 
               RowBox[{"x", ",", " ", "\"\<Aged0To27Days\>\""}], "]"}], "]"}],
              "[", "\"\<Values\>\"", "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"postnatal", " ", "=", " ", 
           RowBox[{"QuantityMagnitude", "/@", " ", 
            RowBox[{
             RowBox[{"NormalData", "[", 
              RowBox[{"[", 
               RowBox[{"x", ",", " ", "\"\<Aged1To59Months\>\""}], "]"}], 
              "]"}], "[", "\"\<Values\>\"", "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"under5", " ", "=", " ", 
           RowBox[{"QuantityMagnitude", "/@", " ", 
            RowBox[{
             RowBox[{"NormalData", "[", 
              RowBox[{"[", 
               RowBox[{"x", ",", " ", "\"\<Aged0To4Years\>\""}], "]"}], "]"}],
              "[", "\"\<Values\>\"", "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{"country", ",", " ", 
               RowBox[{"Length", "[", "year", "]"}]}], "]"}], ",", " ", 
             "year", ",", " ", "neonatal", ",", " ", "postnatal", ",", " ", 
             "under5"}], "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"Length", "[", "NormalData", "]"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", "1"}], " ", 
    RowBox[{"(*", 
     RowBox[{"1", " ", "flatten", " ", "level"}], " ", "*)"}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.986047783548897*^9, 3.9860482532887783`*^9, {3.986048294676302*^9, 
   3.9860482967125587`*^9}, 3.9860483717207527`*^9, {3.986048867228855*^9, 
   3.9860488811698513`*^9}, {3.986048943013035*^9, 3.9860489489921837`*^9}},
 CellTags->{"ExampleInput", "TemplateContent"},
 CellLabel->"In[17]:=",
 CellID->61006139,ExpressionUUID->"a252a8f9-a807-cf4f-ac7e-13946e09a1cb"],

Cell["\<\
cleanData now contains {country, year, neonatal, postnatal, under5} as a list \
and ready to begin further analysis.\
\>", "CodeText",
 CellChangeTimes->{{3.986048883352049*^9, 3.9860489791997757`*^9}, {
  3.9860491380087337`*^9, 3.9860491618986816`*^9}},
 CellID->514032973,ExpressionUUID->"2cf02cb1-b1c0-844b-af66-30c4c1d9598f"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"cleanData", "[", 
   RowBox[{"[", 
    RowBox[{"1", ";;", "5"}], "]"}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{"this", " ", "outputs", " ", "the", " ", "first", " ", "country", " ", 
    RowBox[{"i", ".", "e", ".", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<Afghanistan\>\"", ",", "2000", ",", "0", ",", "205", ",",
          "205"}], "}"}], ",", 
       RowBox[{
       "...", " ", "with", " ", "different", " ", "data", " ", "for", " ", 
        "different", " ", "years"}]}], " "}]}]}], "*)"}], "*)"}]], "Input",
 CellChangeTimes->{{3.9860483973135777`*^9, 3.986048412280964*^9}, {
  3.9860484812010784`*^9, 3.986048486899721*^9}, {3.986048533560173*^9, 
  3.9860486291347656`*^9}, {3.986049000663954*^9, 3.9860490109212284`*^9}},
 CellLabel->"In[18]:=",
