  RowBox[{"Show", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Transpose", "[", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"topYear", ",", " ", "topDeath"}], "}"}], "]"}], ",", 
