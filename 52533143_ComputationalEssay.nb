  3.986051115772442*^9, 3.9860511302584667`*^9}},
 CellTags->{"ExampleCodeText", "TemplateContent"},
 CellID->89179849,ExpressionUUID->"2a44e597-f2f7-0545-b4c8-48b3015b8dcb"],

