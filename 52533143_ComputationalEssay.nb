      RowBox[{"All", ",", " ", "5"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"TableForm", "[", 
  RowBox[{"cleanData", ",", " ", 
   RowBox[{"TableHeadings", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"\"\<Country\>\"", ",", " ", "\"\<Year\>\"", ",", 
        " ", "\"\<Neonatal\>\"", ",", " ", "\"\<Postnatal\>\"", ",", 
        " ", "\"\<Under 5\>\""}], "}"}]}], " ", "\[IndentingNewLine]", 
     "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9860487697324295`*^9, 3.986048812621765*^9}, {
   3.9860490503992977`*^9, 3.9860490507121754`*^9}, 3.986049569320097*^9},
 CellLabel->"In[19]:=",
 CellID->20409995,ExpressionUUID->"bcd02f38-4087-8c4a-a41c-9183044bebe5"]
}, Open  ]],

