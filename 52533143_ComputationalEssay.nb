Cell[BoxData[{
 RowBox[{
  RowBox[{"country", " ", "=", " ", 
   RowBox[{"Union", "[", 
    RowBox[{"cleanData", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
