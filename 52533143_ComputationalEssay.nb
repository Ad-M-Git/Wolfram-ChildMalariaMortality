      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"Min", "[", "topYear", "]"}], ",", " ", 
        RowBox[{"Max", "[", "topYear", "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", " ", "DarkBlue"}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
